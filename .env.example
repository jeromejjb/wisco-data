DATABASE_URL="file:./dev.db"

# Live data API keys (free registration)
BLS_REGISTRATION_KEY=
CENSUS_API_KEY=
FRED_API_KEY=

# Jobs (at least one recommended for live listings)
USAJOBS_AUTH_KEY=
USAJOBS_USER_AGENT=your@email.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Transit realtime (optional)
MCTS_BUSTIME_KEY=
MADISON_METRO_API_KEY=

# Maps — optional Mapbox token unlocks satellite & premium styles
NEXT_PUBLIC_MAPBOX_TOKEN=
# CARTO basemap key (https://carto.com/basemaps/apikey). Put this in `.env` locally and in Vercel for production. Without it the map uses Esri instead of watermarked tiles.
NEXT_PUBLIC_CARTO_API_KEY=

# Local news — GNews (free tier: https://gnews.io/register) + Google News RSS fallback
GNEWS_API_KEY=

# Workways Agent — Gemini free tier recommended (https://aistudio.google.com/apikey)
GOOGLE_GENERATIVE_AI_API_KEY=
AGENT_MODEL=gemini-2.5-flash
AGENT_PROVIDER=google
# Used when AGENT_MODEL hits quota/credits (each Gemini model has its own free bucket)
AGENT_FREE_MODEL=gemini-2.5-flash-lite

# Or OpenAI (paid)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Admin dashboard — optional; if set, GET /api/prompt-experiments requires Bearer token or ?key=
ADMIN_SECRET=
